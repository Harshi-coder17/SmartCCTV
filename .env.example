# SmartCCTV - Border Intelligence Platform
# Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for demo - zero setup required)
DATABASE_URL=sqlite+aiosqlite:///./smartcctv.db

# PostgreSQL (production - requires Docker or standalone PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://smartcctv:CHANGE_ME@localhost:5432/smartcctv_db

# ─── JWT Security ─────────────────────────────────────────────────────────────
# RS256 key pair paths (auto-generated on first run if not present)
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Evidence Storage ─────────────────────────────────────────────────────────
EVIDENCE_DIR=./evidence
EVIDENCE_PRE_EVENT_SECS=10
EVIDENCE_POST_EVENT_SECS=20

# ─── Model Paths ─────────────────────────────────────────────────────────────
MODELS_DIR=./models_cache
YOLO_MODEL=yolov8n.pt
REID_MODEL=osnet_x0_25

# ─── AI Perception ────────────────────────────────────────────────────────────
# Face backend: 'haar' (default, no extra deps) or 'insightface' (full RetinaFace + ArcFace)
FACE_BACKEND=haar
# Use GPU: set to False for CPU-only
USE_GPU=True
# Analytics FPS: process every Nth frame for AI (balance accuracy vs CPU load)
ANALYTICS_FPS=5

# ─── Camera Health ─────────────────────────────────────────────────────────────
CAMERA_HEALTH_INTERVAL_SECS=5

# ─── ReID Matching ─────────────────────────────────────────────────────────────
# Similarity threshold: 0.0 (match everything) to 1.0 (only exact matches)
REID_SIMILARITY_THRESHOLD=0.75
# Margin: if top-1 and top-2 are within this margin, match is ambiguous
REID_MARGIN_THRESHOLD=0.10

# ─── Event Thresholds ─────────────────────────────────────────────────────────
LOITERING_THRESHOLD_SECS=30
ABANDONED_OBJECT_THRESHOLD_SECS=60

# ─── Security Ledger ──────────────────────────────────────────────────────────
HASH_LEDGER_PATH=./logs/hash_ledger.db
AUDIT_LOG_PATH=./logs/audit.log
# Ledger backend: 'sqlite' (demo) or 'hyperledger' (production - requires Fabric network)
HASH_LEDGER_BACKEND=sqlite

# ─── API / CORS ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── PostgreSQL (for docker-compose) ─────────────────────────────────────────
POSTGRES_USER=smartcctv
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=smartcctv_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
